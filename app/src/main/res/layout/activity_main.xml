<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/formularioRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="32dp">

        <!-- Título principal -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/contacto_titulo"
            android:textAppearance="?attr/textAppearanceHeadlineMedium"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <!-- Tarjeta de Video (Mockup Examen) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/tarjetaVideo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#D0DCD4"
            app:cardBackgroundColor="@color/video_preview_bg">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Ícono circular interactivo (Preview / Play) -->
                <FrameLayout
                    android:id="@+id/contenedorIconoVideo"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="@drawable/ic_launcher_background"
                    android:backgroundTint="@color/uth_green_light"
                    android:contentDescription="@string/contacto_reproducir_video">

                    <ImageView
                        android:id="@+id/iconoEstadoVideo"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_videocam"
                        app:tint="@color/uth_green" />

                    <!-- Insignia Play sobrepuesta cuando hay video -->
                    <ImageView
                        android:id="@+id/iconoPlayVideo"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_gravity="center"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_play_circle"
                        app:tint="@color/video_accent_red"
                        android:visibility="gone" />
                </FrameLayout>

                <!-- Estado del video -->
                <TextView
                    android:id="@+id/videoContacto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="@string/contacto_sin_video"
                    android:textAppearance="?attr/textAppearanceBodyMedium"
                    android:textColor="?android:attr/textColorSecondary"
                    android:gravity="center" />

                <!-- Botón de Tomar Video -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/tomarVideo"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="12dp"
                    android:text="@string/contacto_tomar_video"
                    android:textColor="@color/white"
                    app:icon="@drawable/ic_videocam"
                    app:iconTint="@color/white"
                    app:iconGravity="textStart"
                    app:backgroundTint="@color/uth_green"
                    app:cornerRadius="27dp" />

                <!-- Botón opcional de reproducir vista previa local -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/reproducirVideoLocal"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/contacto_reproducir_video"
                    android:textColor="@color/uth_green"
                    app:icon="@drawable/ic_play_circle"
                    app:iconTint="@color/uth_green"
                    app:iconGravity="textStart"
                    app:strokeColor="@color/uth_green"
                    app:cornerRadius="24dp"
                    android:visibility="gone" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Campo Nombre -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:labelFor="@+id/nombreContacto"
            android:text="@string/contacto_nombre"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/nombreContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="150"
            android:maxLines="1"
            android:singleLine="true" />

        <!-- Campo Teléfono -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/telefonoContacto"
            android:text="@string/contacto_telefono"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?android:attr/textColorSecondary" />

        <EditText
            android:id="@+id/telefonoContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:hint="@string/contacto_telefono_ejemplo"
            android:maxLines="1"
            android:singleLine="true" />

        <!-- Ubicación -->
        <TextView
            android:id="@+id/latitudContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:text="@string/contacto_latitud_pendiente"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <TextView
            android:id="@+id/longitudContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/contacto_longitud_pendiente"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Botón Salvar Contacto -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/salvarContacto"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/contacto_salvar"
            android:textColor="@color/white"
            app:backgroundTint="@color/uth_green"
            app:cornerRadius="27dp" />

        <!-- Botón Contactos Salvados (Azul, wireframe Pág 1 - enlace a Pantalla 2) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/contactosSalvados"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="12dp"
            android:text="@string/contacto_ver_salvados"
            android:textColor="@color/white"
            app:icon="@drawable/ic_contacts"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:backgroundTint="@color/uth_blue"
            app:cornerRadius="27dp" />

        <!-- Indicador de progreso -->
        <ProgressBar
            android:id="@+id/progresoGuardado"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <!-- Estado de guardado -->
        <TextView
            android:id="@+id/estadoGuardado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBodyMedium" />

        <!-- Botón Reintentar -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/reintentarGuardado"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="8dp"
            android:text="@string/contacto_reintentar"
            android:textColor="@color/uth_green"
            app:strokeColor="@color/uth_green"
            app:cornerRadius="25dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
