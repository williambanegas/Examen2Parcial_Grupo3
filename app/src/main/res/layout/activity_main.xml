<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/formularioRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/contacto_titulo"
            android:textAppearance="?android:attr/textAppearanceLarge" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:labelFor="@+id/nombreContacto"
            android:text="@string/contacto_nombre" />

        <EditText
            android:id="@id/nombreContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="textPersonName|textCapWords"
            android:maxLength="150"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:labelFor="@+id/telefonoContacto"
            android:text="@string/contacto_telefono" />

        <EditText
            android:id="@id/telefonoContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="phone"
            android:maxLength="30"
            android:maxLines="1"
            android:singleLine="true" />

        <TextView
            android:id="@+id/latitudContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contacto_latitud_pendiente" />

        <TextView
            android:id="@+id/longitudContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/contacto_longitud_pendiente" />

        <TextView
            android:id="@+id/videoContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/contacto_sin_video" />

        <Button
            android:id="@+id/cargarPrueba"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/contacto_cargar_prueba"
            android:visibility="gone"
            app:backgroundTint="#00532C"
            android:textColor="#FFFFFF"/>

        <Button
            android:id="@+id/salvarContacto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/contacto_salvar"
            app:backgroundTint="#00532C"
            android:textColor="#FFFFFF"/>

        <ProgressBar
            android:id="@+id/progresoGuardado"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/estadoGuardado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:accessibilityLiveRegion="polite" />

        <Button
            android:id="@+id/reintentarGuardado"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/contacto_reintentar"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
