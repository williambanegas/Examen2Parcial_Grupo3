<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/verVideoRaiz"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Barra superior moderna -->
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbarVerVideo"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/uth_green"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="@color/white"
        app:title="@string/ver_video_titulo"
        app:titleTextColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Contenedor del reproductor -->
    <FrameLayout
        android:id="@+id/contenedorVideo"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/toolbarVerVideo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <VideoView
            android:id="@+id/videoView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center" />

        <!-- Indicador de carga mientras descarga el buffer -->
        <LinearLayout
            android:id="@+id/cargandoVideoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="16dp">

            <ProgressBar
                android:id="@+id/progresoCargaVideo"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:indeterminateTint="@color/uth_green_light" />

            <TextView
                android:id="@+id/textoCargandoVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/ver_video_cargando"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Vista de error si falla la conexión -->
        <LinearLayout
            android:id="@+id/errorVideoLayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="24dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/textoErrorVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/ver_video_error"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <Button
                android:id="@+id/botonReintentarVideo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:text="@string/contacto_reintentar"
                android:textColor="@color/white"
                app:backgroundTint="@color/uth_green"
                app:cornerRadius="20dp" />
        </LinearLayout>
    </FrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
